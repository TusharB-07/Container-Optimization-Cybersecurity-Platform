# Phase 3 — single source of truth for session lifecycle / reaper config (FR-08/09/10).
# ---------------------------------------------------------------------------
# Consumers:
#   - orchestrator/api.js      (defaults when env not overridden)
#   - orchestrator/reaper.sh   (sampling loop thresholds + grace)
#   - compose/session.yml      (fallback defaults equal these values; CI parity asserts)
#   - ci/smoke.sh              (parity assertion, step 9)
#
# PRD §12 open question resolution [ASSUMPTION]: "What idle threshold (minutes)
# should trigger the reaper warning?" → default 10 minutes of near-zero network
# I/O, tunable per lab type (lab-configs/*.yml may override IDLE_THRESHOLD_S).
IDLE_POLL_INTERVAL_S=30          # FR-09: fixed sampling interval
IDLE_RX_KB_THRESHOLD=8           # FR-09: "near-zero" = < X KB rx per interval
                                 #   (baseline: an idle pair legitimately moves
                                 #    healthcheck pings only — ~2 KB/interval.
                                 #    8 KB gives 4x headroom against false positives.)
IDLE_CONSECUTIVE_SAMPLES=20      # FR-09: N consecutive low samples → flag (20 x 30s = 10 min)
REAPER_GRACE_PERIOD_S=120        # FR-10: learner-facing warning window before teardown
TEARDOWN_TIMEOUT_S=15            # docker stop -t budget (containers are tini-supervised)
SESSION_MAX_LIFETIME_H=8         # hard cap safety net: sessions older than this are
                                 #   flagged regardless of activity (overnight abandonment)

# ---- Live benchmark measurement protocol (Phase 5, docs/final-benchmark-report.md)
# Single source of truth for the on-demand measurement seam: benchmark/measure-live.sh
# reads these (no literal values in the script), orchestrator/api.js re-exposes them in
# GET /benchmarks/status so the dashboard can show "what this run will do", and the
# docs quote them instead of restating numbers.
#
# The defaults ARE the recorded 2026-10-01 baseline protocol
# (docs/before-after-measurements.json: "one pair, 60s settle, 8 samples at 8s
# intervals, docker stats --no-stream; identical for both sides"). Keeping the live
# protocol identical to the audited one is what makes a live number comparable to the
# BASELINE badge it sits next to; changing a value here changes BOTH the measurement and
# the documented protocol, which is intentional (no magic numbers duplicated).
BENCH_SESSION_ID=bmlive          # session id for the measured pair; container/network
                                 #   names derive from it via provision.sh (sess-<id>-*)
BENCH_BUNDLE=web-exploitation    # lab bundle provisioned for the live measurement
BENCH_SETTLE_S=60                # wait after both healthchecks pass before sampling
BENCH_SAMPLES=8                  # number of `docker stats --no-stream` samples
BENCH_SAMPLE_INTERVAL_S=8        # interval between samples
